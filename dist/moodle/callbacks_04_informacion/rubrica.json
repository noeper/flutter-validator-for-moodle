{
  "nombre": "Ejercicio 4 · Enviar el título",
  "criterios": [
    {
      "id": "tipo_texto",
      "descripcion": "onInscribirse pasa a ser void Function(String)",
      "puntos": 1,
      "regla": "ambito_contiene",
      "clase": "TarjetaEvento",
      "patron": "final\\s+(?:void\\s+Function\\s*\\(\\s*String(?:\\s+\\w+)?\\s*\\)|ValueChanged\\s*<\\s*String\\s*>)\\s+onInscribirse\\s*;"
    },
    {
      "id": "envia_titulo",
      "descripcion": "Al pulsar el botón, la tarjeta envía su título: onInscribirse(titulo)",
      "puntos": 1,
      "regla": "ambito_contiene",
      "clase": "TarjetaEvento",
      "patron": "onPressed\\s*:[\\s\\S]*?onInscribirse\\s*!?\\s*(?:\\.call)?\\s*\\(\\s*(?:widget\\.)?titulo\\s*\\)"
    },
    {
      "id": "recibe_titulo",
      "descripcion": "La pantalla recibe el título en sus callbacks",
      "puntos": 1,
      "regla": "llamadas_con_propiedad",
      "estado_de": "PantallaEventos",
      "llamada": "TarjetaEvento",
      "propiedad": "onInscribirse",
      "patron_valor": "^(?:\\(\\s*(?:String\\s+)?\\w+\\s*\\)\\s*(?:=>|\\{)|_?\\w+$)",
      "minimo": 3
    },
    {
      "id": "mensaje_titulo",
      "descripcion": "El SnackBar dice «Te has inscrito en …» con el título recibido",
      "puntos": 1,
      "regla": "ambito_contiene",
      "estado_de": "PantallaEventos",
      "patron": "Te has inscrito en \\$\\{?\\s*\\w+"
    },
    {
      "id": "ultima",
      "descripcion": "La pantalla guarda y muestra «Última inscripción: …» con el título recibido",
      "puntos": 1,
      "regla": "todas",
      "reglas": [
        {
          "regla": "ambito_contiene",
          "estado_de": "PantallaEventos",
          "patron": "\\bString\\s+_?\\w+\\s*=\\s*['\\\"]"
        },
        {
          "regla": "ambito_contiene",
          "estado_de": "PantallaEventos",
          "patron": "Última inscripción[^'\\\"]*\\$\\{?\\s*_?\\w+"
        },
        {
          "regla": "ambito_contiene",
          "estado_de": "PantallaEventos",
          "patron": "setState\\s*\\([\\s\\S]*?\\b_?\\w+\\s*=\\s*\\w+\\s*;"
        }
      ]
    },
    {
      "id": "contador",
      "descripcion": "La AppBar muestra el contador de inscripciones (una variable de la pantalla) y sube dentro de setState()",
      "puntos": 1,
      "regla": "contador_en_llamada",
      "estado_de": "PantallaEventos",
      "llamada": "AppBar"
    }
  ]
}
