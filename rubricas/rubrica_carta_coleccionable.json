      "propiedades": {"color": "Colors.amber.shade100", "elevation": "10"}
    },
    {
      "id": "card_radio",
      "descripcion": "La Card tiene esquinas redondeadas de radio 20",
      "puntos": 1,
      "regla": "widget_configurado",
      "configuracion": {
        "tipo": "Card",
        "rutas": [
          {"ruta": ["shape", "borderRadius"], "tipo_final": "BorderRadius.circular", "argumentos": ["20"]}
        ]
      }
    },
    {
      "id": "nombre",
      "descripcion": "Dashito tiene tamaño 24 y negrita",
      "puntos": 1,
      "regla": "widget_configurado",
      "configuracion": {
        "tipo": "Text",
        "argumentos": ["'Dashito'"],
        "rutas": [
          {"ruta": ["style", "fontSize"], "valor": "24"},
          {"ruta": ["style", "fontWeight"], "valor": "FontWeight.bold"}
        ]
      }
