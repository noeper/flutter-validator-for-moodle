          {"ruta": ["style", "padding", "horizontal"], "valor": "40"},
          {"ruta": ["style", "padding", "vertical"], "valor": "14"},
          {"ruta": ["style", "shape", "borderRadius"], "tipo_final": "BorderRadius.circular", "argumentos": ["30"]}
        ]
